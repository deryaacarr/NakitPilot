# =============================================================================
# NakitPilot — root environment template
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# =============================================================================

# --- Required secrets (leave empty in this example; set locally) ---
SECRET_KEY=
JWT_SIGNING_KEY=
# Optional; if empty, derived from SECRET_KEY (set a dedicated key in production)
INTEGRATIONS_FERNET_KEY=
# KolayBi — set true for local UI demo without live API (or use api_key starting with mock-)
# KOLAYBI_MOCK=true
# KOLAYBI_SANDBOX=true
# KOLAYBI_BASE_URL=
SENTRY_DSN=

# JWT lifetimes (optional)
# JWT_ACCESS_MINUTES=15
# JWT_REFRESH_DAYS=7

# --- Data stores ---
DATABASE_URL=postgresql://nakitpilot:nakitpilot@localhost:5432/nakitpilot
REDIS_URL=redis://localhost:6379/0

# --- Observability (NP-183) ---
SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_RELEASE=
# SENTRY_TRACES_SAMPLE_RATE=0.1

# NP-185 — initial admin (never commit real passwords)
# INITIAL_ADMIN_EMAIL=admin@example.com
# INITIAL_ADMIN_PASSWORD=

# --- API ---
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1,api,nginx,web
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:3000,http://127.0.0.1:3000

# Production compose (docker-compose.prod.yml) forces DEBUG=false.
# Set a strong POSTGRES_PASSWORD before `docker compose -f docker-compose.prod.yml up`.
# NGINX_HTTPS_PORT=443
# TLS_CN=localhost

# --- S3-compatible storage ---
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=auto

# --- Private uploads (NP-152; outside web root) ---
# PRIVATE_UPLOAD_ROOT=

# --- Rate limits (NP-151; production defaults when DEBUG=false) ---
# AUTH_LOGIN_RATE=10/min
# AUTH_REFRESH_RATE=30/min
# IMPORT_UPLOAD_RATE=20/hour

# --- Backups (NP-155) ---
# BACKUP_RETENTION_DAYS=14
# BACKUP_FAILURE_WEBHOOK=

# --- Celery (defaults to REDIS_URL if omitted) ---
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- Web (Next.js public) ---
NEXT_PUBLIC_APP_NAME=NakitPilot
NEXT_PUBLIC_APP_URL=http://localhost
NEXT_PUBLIC_API_URL=http://localhost/api

# --- Invitations (MVP: shareable link, no outbound email required) ---
INVITE_BASE_URL=http://localhost:3000
INVITE_EXPIRY_DAYS=7

# --- Postgres image bootstrap (docker compose only) ---
POSTGRES_DB=nakitpilot
POSTGRES_USER=nakitpilot
POSTGRES_PASSWORD=nakitpilot

# --- Optional published ports ---
# API_PORT=8000
# WEB_PORT=3000
# NGINX_PORT=80
# REDIS_PORT=6379
# POSTGRES_PORT=5432
